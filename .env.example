# ---- Banco de dados (Neon) ----
# Use a connection string POOLED do console Neon.
# Nao use channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- App ----
# No Railway: Settings → Networking → Generate Domain, depois cole a URL https aqui.
# APP_URL e a URL PUBLICA desta API (nao a do frontend). Sem barra no final.
# Ex.: https://backperfilpro-production.up.railway.app
NODE_ENV=production
PORT=3333
APP_URL=https://SEU-SERVICO.up.railway.app
FRONTEND_URL=https://seu-front.vercel.app
# Varias origens: separe por virgula (local + producao)
CORS_ORIGIN=https://seu-front.vercel.app,http://localhost:3000

# ---- Tokens ----
JWT_SECRET=troque-esse-segredo-de-access-token-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# ---- Cookies ----
# No Railway (HTTPS) deixe true. COOKIE_DOMAIN so se o front e a API forem o mesmo site.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ---- E-mail (SMTP) ----
MAIL_TRANSPORT=console
MAIL_FROM="PerfilPro <no-reply@perfilpro.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Upload de avatar (Supabase Storage) ----
# Use a service role SOMENTE no backend. Nunca coloque essa chave no frontend.
# Dashboard: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (secret)
SUPABASE_STORAGE_BUCKET=avatars

# JPEG, PNG ou WEBP, max 1 MB. A API converte para WEBP 256x256.
# Avatares antigos em disco ainda sao servidos em /uploads (legado).
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE_MB=1

# ---- Stripe (assinaturas Pro / Premium) ----
# Crie as chaves em https://dashboard.stripe.com/apikeys (modo teste).
# Depois rode: npm run stripe:setup  — o script cria os produtos e imprime os Price IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
