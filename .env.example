# ---- Banco de dados (Neon) ----
# Use a connection string POOLED do console Neon.
# Nao use channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- App ----
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Tokens ----
JWT_SECRET=troque-esse-segredo-de-access-token-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# ---- Cookies ----
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- E-mail (SMTP) ----
MAIL_TRANSPORT=console
MAIL_FROM="PerfilPro <no-reply@perfilpro.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Upload de avatar ----
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE_MB=2

# ---- Stripe (assinaturas Pro / Premium) ----
# Crie as chaves em https://dashboard.stripe.com/apikeys (modo teste).
# Depois rode: npm run stripe:setup  — o script cria os produtos e imprime os Price IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
